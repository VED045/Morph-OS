# Provider credentials stay here, never in the APK.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Run python -m morphos.nebius to see the account catalog, then copy exact IDs.
NEBIUS_FAST_MODEL=
NEBIUS_COMPLEX_MODEL=
# Optional image route: verify the configured model's image capability separately.
NEBIUS_VISION_MODEL=
NEBIUS_VISION_VERIFIED=false
# Separate token for authorized Android clients; generate at least 32 random bytes.
MORPHOS_CLIENT_TOKEN=
REQUESTS_PER_MINUTE=10

# Optional self-hosted theme community. Empty database path disables it.
COMMUNITY_DATABASE=
# Separate invite to create creator keys; never share MORPHOS_CLIENT_TOKEN with creators.
COMMUNITY_INVITE=
